# 安装到 /etc/systemd/system/ 后启用；Caddy 对公网提供 TLS，Node 仅监听回环。
[Unit]
Description=Garrison Protocol multiplayer synchronization
After=network.target
[Service]
Type=simple
WorkingDirectory=/opt/garrison-protocol
ExecStart=/opt/node-v24.21.0-linux-x64/bin/node multiplayer/server/index.js
Environment=HOST=127.0.0.1
Environment=PORT=8080
Restart=on-failure
RestartSec=3
DynamicUser=true
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
[Install]
WantedBy=multi-user.target
